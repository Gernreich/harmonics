10 DIM W(100),X(100)
20 INPUT A,B,C
30 D=(B-A)/C
40 E=SIN(A):A=A+D
50 F=SIN(A)
60 IF F>E THEN 80
70 IF F<E THEN 130
80 IF F>E THEN 100
90 W(N)=A:X(N)=SIN(A):N=N+1:GOTO 60
100 E=F:A=A+D:F=SIN(A)
110 IF A>B THEN 180
120 GOTO 100
130 IF F<E THEN 150
140 W(N)=A:X(N)=SIN(A)
150 E=F:A=A+D:F=SIN(A)
160 IF A>B THEN 180
170 GOTO 130
180 FOR R=0 TO N
190 PRINT W(R);X(R)
200 NEXT R
210 END
