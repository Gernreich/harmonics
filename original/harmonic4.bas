5 DIM B(100),C(100),T(100)
10 FOR X=1 TO 20
20 FOR Y=1 TO 20
30 M=((2*X)+Y)/(X+Y)
35 IF M<1.5 THEN 60
40 A=A+1
50 B(A)=M
60 NEXT Y,X
65 N=1
70 FOR I=N+1 TO A
75 IF B(N)=B(I) THEN B(I)=0
80 NEXT I
85 N=N+1
90 IF N= THEN 110
100 GOTO 70
110 FOR I=1 TO A
120 IF B(I)=0 THEN 150
130 Z=Z+1
140 C(Z)=B(I)
150 NEXT I
160 FOR X=1 TO 10
170 FOR Y=1 TO 10
180 M=((2*X)+Y)/(X+Y)
190 FOR O=1 TO 2
200 IF C(O)=M THEN T(O)=T(O)+1
210 NEXT O
220 NEXT Y,X
230 FOR X=1 TO 2
240 PRINT C(O);T(O)
250 NEXT O
