10 A=.5
20 B=1.5
30 B=B+A
40 PRINT B
50 FOR C=2 TO B
60 FOR D=2 TO C
70 E=((2*C)+D-3)/(C+D-2)
80 IF E=3/2 THEN F=F+1
90 IF E=5/3 THEN G=G+1
100 IF E=7/4 THEN H=H+1
110 IF E=8/5 THEN I=I+1
120 IF E=9/5 THEN J=J+1
130 IF E=11/7 THEN K=K+1
140 IF E=11/6 THEN L=L+1
150 IF E=12/7 THEN M=M+1
160 IF E=13/8 THEN N=N+1
170 IF E=14/9 THEN O=O+1
180 IF E=13/7 THEN P=P+1
190 NEXT D
200 NEXT C
210 PRINT F;G;H;I;J;K;L;M;N;O;P
220 F=0
230 G=0
240 H=0
250 I=0
260 J=0
270 K=0
280 L=0
290 M=0
300 N=0
310 O=0
320 P=0
330 A=A*2
340 GOTO 30
