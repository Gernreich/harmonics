1 CLS
2 KEY OFF
3 SCREEN 0
10 A=.5
20 B=2
30 FOR C=2 TO 32769!
40 FOR D=2 TO C
50 E=((2*C)+D-3)/(C+D-2)
60 IF E=3/2 THEN F=F+1
70 IF E=5/3 THEN G=G+1
80 IF E=7/4 THEN H=H+1
90 IF E=8/5 THEN I=I+1
100 IF E=9/5 THEN J=J+1
110 IF E=11/7 THEN K=K+1
120 IF E=11/6 THEN L=L+1
130 IF E=12/7 THEN M=M+1
140 IF E=13/8 THEN N=N+1
150 IF E=14/9 THEN O=O+1
160 IF E=13/7 THEN P=P+1
170 IF B=C AND B=D THEN GOSUB 220
180 IF B=C AND B=D THEN A=A*2
190 IF B=C AND B=D THEN B=B+A
200 NEXT D
210 NEXT C
220 PRINT F;G;H;I;J;K;L;M;N;O;P
230 RETURN
