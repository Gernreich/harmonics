100 CLS
110 KEY OFF
120 SCREEN 2
130 FOR X=1 TO B
140 IF N/P(X)=INT(X/(P(X))) THEN 190
150 GOTO 270
160 B=B+1:P(B)=N
170 C=C+1:T(C)=N
180 GOTO 280
190 FOR M=1 TO C
200 IF T(M)=P(X) THEN 240
210 NEXT M
220 C=C+1
230 T(C)=P(X)
240 N=N/P(X)
250 IF N=1 THEN 280
260 IF N/P(X)=INT(N/P(X)) THEN 240
270 NEXT X
280 FOR N=1 TO C
290 PSET(S,Y)
310 S=S+T(M)
320 IF S>159 THEN 340
330 GOTO 290
340 S=0
350 NEXT N
360 Y=Y+1
370 IF Y>159 THEN END
380 FOR M=1 TO C
390 T(M)=0
400 NEXT M
410 C=0
420 Z=Z+1:N=Z
430 GOTO 130
